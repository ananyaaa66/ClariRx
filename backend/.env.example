# ClariRx Backend Environment Variables
# Copy this file to '.env' and fill in your actual API keys.

# Google Gemini API Key (Used for LLM extraction and generating explanations)
# Get one here: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional: Used for faster, alternative LLM processing)
# Get one here: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Token (Optional: Only needed if downloading restricted models in the future)
HF_TOKEN=your_huggingface_token_here
